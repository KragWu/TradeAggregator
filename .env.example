# Chemin vers le fichier JSON de compte de service Google
GOOGLE_SHEETS_CREDENTIALS=credentials.json

# ID de la feuille Google (partie URL entre /d/ et /edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Nom de l'onglet dans la feuille (par défaut "Feuille 1")
GOOGLE_SHEET_WORKSHEET=

# URL du forum Boursorama pour récupérer les 10 valeurs les plus lues
BOURSORAMA_FORUM_URL=https://www.boursorama.com/bourse/forum/

# Valeurs à exclure de la collecte (séparées par des virgules)
# Exemple : CAC 40,EURO STOXX 50,S&P 500
EXCLUDED_VALUES=

# Valeurs supplémentaires à scrapper (codes séparés par virgule)
# Exemple: ADDED_VALUES=tracker-1rTDCAM,action-1rPTTE
ADDED_VALUES=
